# Production environment template
# Copy this file to server/.env on the server and replace every placeholder.
DATABASE_URL=postgresql://carbonledger:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/carbonledger?schema=public
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
PORT=3000
