{
  "name": "carbon-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "CarbonLedger - 建筑工程建造阶段碳排放核算多用户 Web 平台",
  "workspaces": [
    "packages/shared",
    "server",
    "web"
  ],
  "scripts": {
    "build:shared": "npm run build -w @carbonledger/shared",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "test": "npm run test --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "vue-demi@0.14.10": true
  }
}
